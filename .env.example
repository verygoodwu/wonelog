# Public site
PUBLIC_SITE_URL=https://blog.example.com

# SSH publishing. Leave WONELOG_SERVER_HOST empty to disable publishing.
WONELOG_SERVER_HOST=
WONELOG_SERVER_USER=deploy
WONELOG_SERVER_KEY=/run/secrets/wonelog_ssh_key
WONELOG_SERVER_SOURCE_DIR=/var/www/wonelog-source
WONELOG_SERVER_SITE_DIR=/var/www/wonelog
WONELOG_SERVER_BLOG_DIR=/var/www/wonelog-source/src/content/blog/
WONELOG_SERVER_CONTENT_DIR=/var/www/wonelog-source/src/content/
WONELOG_SERVER_PUBLIC_IMAGES_DIR=/var/www/wonelog-source/public/images/

# Optional GitHub-backed image library
WONELOG_GITHUB_TOKEN=
WONELOG_GITHUB_REPO=
WONELOG_GITHUB_BRANCH=main
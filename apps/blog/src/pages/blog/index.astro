---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="文章 - Wonelog" description="文章列表">
  <section class="page-title">
    <h1>&#x6587;&#x7AE0;</h1>
    <p>&#x8BB0;&#x5F55;&#x6D4B;&#x8BD5;&#x3001;&#x6E38;&#x620F;&#x3001;&#x751F;&#x6D3B;&#x548C;&#x4E00;&#x4E9B;&#x6B63;&#x5728;&#x53D1;&#x751F;&#x7684;&#x4E8B;&#x3002;</p>
  </section>

  <section class="post-list">
    {posts.map((post, index) => (
      <article class="list-item">
        {post.data.heroImage && <img src={post.data.heroImage} alt={post.data.title} loading={index < 2 ? 'eager' : 'lazy'} decoding="async" />}
        <div>
          <time>{post.data.pubDate.toISOString().slice(0, 10)}</time>
          <h2><a href={`/blog/${post.slug}/`}>{post.data.title}</a></h2>
          <p>{post.data.description}</p>
          <div class="tags">{post.data.tags.map((tag) => <span>{tag}</span>)}</div>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
---
import BaseLayout from '../layouts/BaseLayout.astro';
import projectData from '../content/projects.json';

const projects = [...(projectData.projects ?? [])].sort((a, b) => Number(b.featured) - Number(a.featured));
const articleHref = (value) => {
  if (!value) return '';
  if (value.startsWith('/')) return value;
  return `/blog/${value.replace(/^\/|\/$/g, '')}/`;
};
---
<BaseLayout title="项目 - Wonelog" description="开源项目与技术实践">
  <section class="project-heading">
    <p class="project-eyebrow">OPEN SOURCE</p>
    <h1>项目</h1>
    <p>把工作中的方法沉淀成可以复用、验证和持续迭代的工具。</p>
  </section>

  <section class="projects-list" aria-label="开源项目列表">
    {projects.map((project) => (
      <article class:list={['project-entry', { featured: project.featured }]} id={project.id}>
        <div class="project-media">
          {project.cover ? (
            <img src={project.cover} alt={`${project.name} 项目封面`} loading="eager" decoding="async" />
          ) : (
            <div class="project-placeholder" aria-hidden="true">&lt;/&gt;</div>
          )}
        </div>
        <div class="project-body">
          <div class="project-meta">
            <span class="project-status">{project.status || '维护中'}</span>
            {project.featured && <span class="project-featured">精选</span>}
          </div>
          <h2>{project.name}</h2>
          <p class="project-tagline">{project.tagline}</p>
          <p class="project-description">{project.description}</p>

          {project.tech?.length > 0 && (
            <div class="project-tech" aria-label="技术栈">
              {project.tech.map((item) => <span>{item}</span>)}
            </div>
          )}

          {project.highlights?.length > 0 && (
            <div class="project-section">
              <h3>它解决什么</h3>
              <ul>
                {project.highlights.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          )}

          {project.outputs?.length > 0 && (
            <div class="project-section">
              <h3>交付物</h3>
              <div class="project-outputs">
                {project.outputs.map((item) => <span>{item}</span>)}
              </div>
            </div>
          )}

          <div class="project-actions">
            <a class="project-primary" href={project.repository} target="_blank" rel="noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.29-5.27-5.68 0-1.26.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.16 1.18a10.9 10.9 0 0 1 5.75 0c2.2-1.49 3.16-1.18 3.16-1.18.62 1.58.23 2.75.11 3.04.73.8 1.18 1.82 1.18 3.08 0 4.4-2.71 5.38-5.29 5.67.42.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg>
              查看源码
            </a>
            {project.demo && <a class="project-secondary" href={project.demo} target="_blank" rel="noreferrer">在线体验 ↗</a>}
            {project.article && <a class="project-secondary" href={articleHref(project.article)}>开发文章 →</a>}
          </div>
        </div>
      </article>
    ))}
  </section>

  {projects.length === 0 && (
    <section class="projects-empty">
      <h2>项目正在整理中</h2>
      <p>新的开源实践会陆续放到这里。</p>
    </section>
  )}
</BaseLayout>

<style>
  .project-heading,
  .projects-list,
  .projects-empty {
    width: min(1080px, calc(100% - 40px));
    margin-inline: auto;
  }
  .project-heading {
    padding: 70px 0 38px;
  }
  .project-eyebrow {
    margin: 0 0 8px;
    color: #2563eb;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0;
  }
  .project-heading h1 {
    margin: 0;
    color: #111827;
    font-size: 46px;
    line-height: 1.15;
  }
  .project-heading > p:last-child {
    max-width: 680px;
    margin: 14px 0 0;
    color: #526076;
    font-size: 17px;
    line-height: 1.8;
  }
  .projects-list {
    display: grid;
    gap: 22px;
    padding-bottom: 72px;
  }
  .project-entry {
    display: grid;
    grid-template-columns: minmax(320px, .95fr) minmax(0, 1.25fr);
    overflow: hidden;
    border: 1px solid rgba(148, 163, 184, .34);
    border-radius: 8px;
    background: rgba(255, 255, 255, .92);
    box-shadow: 0 16px 42px rgba(51, 65, 85, .08);
  }
  .project-entry.featured {
    border-color: rgba(37, 99, 235, .32);
  }
  .project-media {
    min-height: 100%;
    background: #eff6ff;
  }
  .project-media img {
    width: 100%;
    height: 100%;
    min-height: 360px;
    object-fit: cover;
    display: block;
  }
  .project-placeholder {
    display: grid;
    min-height: 360px;
    place-items: center;
    color: #2563eb;
    font-size: 54px;
    font-weight: 700;
  }
  .project-body {
    padding: 34px 36px 38px;
  }
  .project-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 13px;
  }
  .project-status,
  .project-featured,
  .project-tech span,
  .project-outputs span {
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    padding: 3px 9px;
    border-radius: 4px;
    font-size: 12px;
    line-height: 1.4;
  }
  .project-status { color: #166534; background: #dcfce7; }
  .project-featured { color: #1d4ed8; background: #dbeafe; }
  .project-body h2 {
    margin: 0;
    color: #111827;
    font-size: 28px;
    line-height: 1.3;
  }
  .project-tagline {
    margin: 10px 0 0;
    color: #1d4ed8;
    font-size: 16px;
    line-height: 1.65;
  }
  .project-description {
    margin: 14px 0 0;
    color: #526076;
    line-height: 1.85;
  }
  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 18px;
  }
  .project-tech span { color: #334155; background: #eef2f7; }
  .project-section { margin-top: 24px; }
  .project-section h3 {
    margin: 0 0 10px;
    color: #1f2937;
    font-size: 15px;
  }
  .project-section ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .project-section li {
    position: relative;
    padding-left: 17px;
    color: #4b5563;
    font-size: 14px;
    line-height: 1.7;
  }
  .project-section li::before {
    content: '';
    position: absolute;
    left: 0;
    top: .68em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #2563eb;
  }
  .project-outputs { display: flex; flex-wrap: wrap; gap: 8px; }
  .project-outputs span {
    border: 1px solid #dbe4f0;
    color: #475569;
    background: #fff;
  }
  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }
  .project-actions a {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }
  .project-primary { color: #fff; background: #2563eb; }
  .project-primary:hover { background: #1d4ed8; }
  .project-primary svg { width: 17px; height: 17px; }
  .project-secondary { border: 1px solid #cbd5e1; color: #334155; background: #fff; }
  .project-secondary:hover { border-color: #2563eb; color: #1d4ed8; }
  .projects-empty { padding: 40px 0 80px; color: #64748b; }
  .projects-empty h2 { color: #1f2937; }
  @media (max-width: 820px) {
    .project-heading { padding-top: 48px; }
    .project-heading h1 { font-size: 38px; }
    .project-entry { grid-template-columns: 1fr; }
    .project-media img, .project-placeholder { min-height: 230px; }
    .project-body { padding: 26px 22px 30px; }
  }
  @media (max-width: 520px) {
    .project-heading, .projects-list, .projects-empty {
      width: min(100% - 28px, 1080px);
    }
    .project-heading h1 { font-size: 34px; }
    .project-body h2 { font-size: 23px; }
    .project-actions a { width: 100%; }
  }
</style>
---
import '../styles/global.css';
import config from '../content/config.json';

const {
  title = config.siteName ?? 'Wonelog',
  description = config.subtitle ?? '记录、思考与分享'
} = Astro.props;
const path = Astro.url.pathname;
const isActive = (href) => href === '/' ? path === '/' : path.startsWith(href);
const githubUrl = config.socials?.github ? `https://github.com/${config.socials.github}` : '';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://webrd01.is.autonavi.com" />
    <link rel="preconnect" href="https://unpkg.com" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="site-nav">
        <h2><a class="brand" href="/">{config.siteName ?? 'Wonelog'}</a></h2>
        <div class="internal-links">
          <a class:list={[{ active: isActive('/') }]} href="/">首页</a>
          <a class:list={[{ active: isActive('/blog') }]} href="/blog/">文章</a>
          <a class:list={[{ active: isActive('/projects') }]} href="/projects/">项目</a>
          <a class:list={[{ active: isActive('/links') }]} href="/links/">友邻</a>
          <a class:list={[{ active: isActive('/about') }]} href="/about/">关于</a>
        </div>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} {config.siteName ?? 'Wonelog'} · {config.nickname ?? 'Your Name'}</p>
      <p class="sub">{config.subtitle ?? '记录、思考与分享'}</p>
      <div class="site-stats">
        <span>网站已运行 <strong id="days-running">--</strong> 天</span>
        <span class="separator">·</span>
        <span>共访问 <span class="busuanzi" id="busuanzi_value_site_pv">--</span> 次</span>
        <span class="separator">·</span>
        <span><span class="busuanzi" id="busuanzi_value_site_uv">--</span> 位访客</span>
      </div>
      {githubUrl && <div class="social-links"><a href={githubUrl} target="_blank" title="GitHub" rel="noreferrer">GitHub</a></div>}
      {config.icp && <p class="icp"><a href="https://beian.miit.gov.cn/" target="_blank" rel="noreferrer">{config.icp}</a></p>}
    </footer>
    <script async src="https://busuanzi.9426.works/js2/busuanzi.pure.mini.js"></script>
    <script is:inline define:vars={{ startDate: config.startDate ?? '2026-01-01T00:00:00+08:00' }}>
      const start = new Date(startDate);
      const days = Math.max(0, Math.floor((Date.now() - start.getTime()) / 86400000));
      const element = document.getElementById('days-running');
      if (element) element.textContent = String(days);
    </script>
  </body>
</html>
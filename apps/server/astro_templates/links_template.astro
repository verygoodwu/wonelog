---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="zh-CN">
  <head>
    <BaseHead title="友邻 - Wonelog" description="Wonelog 的朋友们" />
    <style is:global>
      /* 网格背景 */
      .links-page {
        max-width: 860px;
        margin: 0 auto;
        padding: 2.5em 1.5em 4em;
      }
      .links-page h1.page-title {
        font-size: 2.4em;
        font-weight: 700;
        margin: 0.6em 0 0.3em;
        color: rgb(15, 18, 25);
      }
      .links-subtitle {
        color: #888;
        font-size: 0.95em;
        margin-bottom: 2em;
      }

      /* 友链网格 */
      .links-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.2em;
      }

      .link-card {
        display: flex;
        align-items: center;
        gap: 1em;
        padding: 1.2em 1.4em;
        border: 1px solid #e8e8e8;
        border-radius: 12px;
        text-decoration: none;
        color: inherit;
        background-color: #fafbfc;
        transition: border-color 0.2s, box-shadow 0.2s, transform 0.15s;
      }
      .link-card:hover {
        border-color: #ccc;
        box-shadow: 0 4px 16px rgba(0,0,0,0.08);
        transform: translateY(-2px);
      }
      .link-card-avatar {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
        border: 1px solid #eee;
        background: #fff;
      }
      .link-card-info {
        min-width: 0;
      }
      .link-card-name {
        font-size: 1.05em;
        font-weight: 600;
        color: #111;
        margin: 0 0 0.25em;
        line-height: 1.3;
      }
      .link-card:hover .link-card-name {
        color: #2337ff;
      }
      .link-card-desc {
        font-size: 0.85em;
        color: #888;
        margin: 0;
        line-height: 1.5;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      /* 响应式 */
      @media (max-width: 640px) {
        .links-grid {
          grid-template-columns: 1fr;
        }
        .links-page h1.page-title {
          font-size: 1.8em;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="links-page">
        <h1 class="page-title">友邻</h1>
        <p class="links-subtitle">我的朋友们</p>
        <div class="links-grid" id="links-grid">
          <!-- 友链卡片由 JS 动态渲染 -->
        </div>
      </div>
    </main>
    <Footer />
    <script>
      // 友链数据（由后台管理系统生成）
      const linksData = LINKS_DATA_PLACEHOLDER;

      // 没有头像时自动获取网站 favicon
      function getFavicon(url) {
        try {
          const u = new URL(url);
          return 'https://favicon.im/' + u.hostname;
        } catch(e) {
          return '';
        }
      }

      function getAvatar(link) {
        if (link.avatar && link.avatar.trim()) return link.avatar;
        return getFavicon(link.url);
      }

      const grid = document.getElementById('links-grid');
      if (linksData && linksData.length > 0) {
        grid.innerHTML = linksData.map(link => `
          <a class="link-card" href="${link.url}" target="_blank" rel="noopener" title="${link.name}">
            <img class="link-card-avatar" src="${getAvatar(link)}" alt="${link.name}" onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 52 52%22><rect fill=%22%23f0f0f0%22 width=%2252%22 height=%2252%22 rx=%2226%22/><text x=%2226%22 y=%2232%22 text-anchor=%22middle%22 font-size=%2220%22 fill=%22%23999%22>${link.name ? link.name[0] : '?'}</text></svg>'">
            <div class="link-card-info">
              <div class="link-card-name">${link.name}</div>
              <div class="link-card-desc">${link.desc || ''}</div>
            </div>
          </a>
        `).join('');
      } else {
        grid.innerHTML = '<p style="grid-column:1/-1;text-align:center;color:#aaa;padding:3em 0;">暂无友链</p>';
      }
    </script>
  </body>
</html>

---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="zh-CN">
  <head>
    <BaseHead title="关于 - Wonelog" description="关于 Your Name" />
    <style>
      .about-page { max-width: 900px; margin: 0 auto; padding: 2em 1.5em 4em; }
      .about-page h1.page-title { font-size: 2.4em; font-weight: 700; margin: 0.6em 0 1em; color: rgb(15, 18, 25); }
      .section-title { font-size: 1.5em; font-weight: 700; margin: 2em 0 0.6em; color: rgb(15, 18, 25); }
      .about-list { list-style: none; padding: 0; margin: 0; }
      .about-list li { position: relative; padding: 0.45em 0 0.45em 1.5em; color: #444; font-size: 1em; line-height: 1.7; }
      .about-list li::before { content: ''; position: absolute; left: 0.25em; top: 0.95em; width: 7px; height: 7px; border-radius: 50%; border: 2px solid #ccc; background: transparent; }
      .sub-text { color: #666; font-size: 0.95em; margin: 0.3em 0 1.5em; line-height: 1.7; }
      .china-map-container { width: 100%; max-width: 700px; margin: 1em auto 0; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.1); }
      #china-map { height: 320px; }
      .map-legend { display: flex; gap: 1.5em; padding: 12px 16px; font-size: 12px; color: #666; background: #fafafa; border-top: 1px solid #e5e7eb; }
      .legend-dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 5px; vertical-align: middle; }
      .legend-dot.live { background: #4285f4; }
      .legend-dot.travel { background: #ff9800; }
      .social-grid { display: flex; flex-wrap: wrap; gap: 0.7em; margin-top: 0.8em; width: 100%; box-sizing: border-box; }
      .social-item { display: flex; align-items: center; gap: 0.5em; padding: 0.6em 0.8em; border: 1px solid #e5e7eb; border-radius: 8px; text-decoration: none; color: #333; font-size: 0.8em; transition: border-color 0.2s, background 0.2s; background: #fff; overflow: hidden; min-width: 0; flex: 1 1 calc(33.3% - 0.5em); max-width: calc(33.3% - 0.5em); }
      .social-item:hover { border-color: #bbb; background: #fafafa; color: #111; }
      .social-icon { width: 16px; height: 16px; flex-shrink: 0; opacity: 0.7; }
      .social-label { font-weight: 500; flex-shrink: 0; }
      .social-sub { color: #999; font-size: 0.8em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 120px; }
      @media (max-width: 700px) { .about-page h1.page-title { font-size: 1.8em; } .china-map-container { max-width: 100%; } .social-grid { flex-direction: column; } .social-item { flex: 1 1 100%; max-width: 100%; padding: 0.5em 0.6em; } .social-sub { max-width: 180px; font-size: 0.75em; } }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="about-page">
        <h1 class="page-title">关于</h1>
        
        <h2 class="section-title" id="about-me">关于我</h2>
        <ul class="about-list">
          <li>Your Name</li>
          <li>东北人，常驻广州。菜鸟QA，努力生活</li>
        </ul>
        
        <h2 class="section-title" id="footprint">足迹</h2>
        <p class="sub-text">去过的一些地方</p>
        <div class="china-map-container">
          <div id="china-map"></div>
          <div class="map-legend">
            <span><span class="legend-dot live"></span>居住</span>
            <span><span class="legend-dot travel"></span>旅行</span>
          </div>
        </div>
        
        <h2 class="section-title" id="contact">联系我</h2>
        <div class="social-grid">
          <a class="social-item" href="https://github.com/" target="_blank" rel="noopener">
            <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
            <span class="social-label">GitHub</span>
            <span class="social-sub">@</span>
          </a>
          <a class="social-item" href="https://example.com/rss.xml" target="_blank" rel="noopener">
            <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/></svg>
            <span class="social-label">RSS</span>
            <span class="social-sub">订阅博客</span>
          </a>
          <a class="social-item" href="mailto:hello@example.com" target="_blank" rel="noopener">
            <svg class="social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <span class="social-label">邮件</span>
            <span class="social-sub">hello@example.com</span>
          </a>
        </div>
      </div>
    </main>
    <Footer />
    
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
      const cityData = [{"name": "广州", "lon": 113.2644, "lat": 23.1291, "type": "live", "desc": "打工人的墓地，广州风气有时候感觉真的不好"}, {"name": "北京", "lon": 116.4074, "lat": 39.9042, "type": "travel", "desc": "上次去还是小学"}, {"name": "上海", "lon": 121.4737, "lat": 31.2304, "type": "travel", "desc": "第一次喝25块钱的小听可乐，然后还要我自己倒杯子里，羞辱人。"}, {"name": "深圳", "lon": 114.0579, "lat": 22.5431, "type": "travel", "desc": "哈尔滨对不住了，我已经是深圳人了。"}, {"name": "香港", "lon": 114.1694, "lat": 22.3193, "type": "travel", "desc": "奶粉天堂，当年一年两次都是去买奶粉，后来变成了去吃香港麦当劳限定早餐。"}, {"name": "澳门", "lon": 113.5439, "lat": 22.1987, "type": "travel", "desc": "第一次去那年17，爸妈在里面玩我在外面游荡。唯一的印象奶茶很贵，几十澳元。"}, {"name": "杭州", "lon": 0.0, "lat": 0.0, "type": "travel", "desc": "杭州感觉真的挺养人的，可惜房价贵要不然肯定去养老"}, {"name": "苏州", "lon": 0.0, "lat": 0.0, "type": "travel", "desc": "10月中旬去的，古镇的螃蟹太好吃了。一口下去黏嘴"}, {"name": "哈尔滨", "lon": 0.0, "lat": 0.0, "type": "live", "desc": "我的老家，只能是老家了。"}];
      
      const map = L.map('china-map', {
        center: [32, 110],
        zoom: 4,
        zoomControl: true,
        scrollWheelZoom: true,
        attributionControl: false,
        maxBounds: [[15, 70], [55, 140]],
        maxBoundsViscosity: 1.0,
        minZoom: 3,
        maxZoom: 18
      });
      
      L.tileLayer('https://webrd0{s}.is.autonavi.com/appmaptile?lang=zh_cn&size=1&scale=1&style=8&x={x}&y={y}&z={z}', {
        subdomains: '1234',
        maxZoom: 18,
      }).addTo(map);
      
      cityData.forEach(city => {
        const color = city.type === 'live' ? '#4285f4' : '#ff9800';
        const icon = L.divIcon({
          className: 'custom-marker',
          html: `<div style="width:14px;height:14px;background:${color};border:2px solid #fff;border-radius:50%;box-shadow:0 2px 8px rgba(0,0,0,0.3);"></div>`,
          iconSize: [14, 14],
          iconAnchor: [7, 7],
        });
        L.marker([city.lat, city.lon], { icon }).addTo(map).bindPopup(`<strong>${city.name}</strong><br>${city.desc}`);
      });
    </script>
  </body>
</html>
